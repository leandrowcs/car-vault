# Public Firebase Web configuration. Never place service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gas stations: same-origin read-only proxy (Vite dev/preview and Vercel).
# Other hosts must provide an equivalent proxy before enabling Gas Québec prices.
VITE_GAS_QUEBEC_ENDPOINT=/api/gas-stations
VITE_LOCATION_SEARCH_ENDPOINT=/api/location-search
VITE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
